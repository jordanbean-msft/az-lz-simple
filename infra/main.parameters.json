      "value": "${AZURE_GITHUB_REPO_URL}"
    },
    "githubPat": {
      "value": "${AZURE_GITHUB_PAT}"
    },
    "githubActionsAdminPublicKey": {
      "value": "${AZURE_GITHUB_ACTIONS_ADMIN_PUBLIC_KEY}"
    },
    "adminUsername": {
      "value": "${AZURE_ADMIN_USERNAME}"
    },
    "adminPassword": {
      "value": "${AZURE_ADMIN_PASSWORD}"
    },
    "dnsResolverVm": {
      "value": {
        "diskSizeGB": 30,
