      "value": "private-endpoint"
    },
    "privateEndpointSubnetAddressPrefix": {
      "value": "10.255.2.0/28"
    },
    "stopCompute": {
      "value": {
        "timeZone": "Central Standard Time",
        "interval": 1,
        "frequency": "Day",
