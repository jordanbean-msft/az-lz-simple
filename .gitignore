# ──────────────────────────────────────────────────────────
# az-lz-simple — Azure Landing Zone (Bicep + shell scripts)
# ──────────────────────────────────────────────────────────

# ── Local Azure configuration (contains tenant/subscription/resource IDs) ──
.azure-debug-config.json
.azure-debug-config.last-sync

# ── Azure Developer CLI (azd) ──
# .azure/ has its own .gitignore that excludes environment secrets;
# the directory itself is NOT committed
.azure/

# ── Generated IaC artifacts ──
infra/main.json

# ── OS files ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Editors & IDEs ──
.vs/
.vscode/.ropeproject
.vscode/*.code-workspace
*.swp
*.swo
*~

# ── Shell / script artifacts ──
*.log

# ── Python artifacts ──
__pycache__/
*.pyc

# ── Secrets & credentials (never commit) ──
*.pem
*.key
*.pfx
*.p12
